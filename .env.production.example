# ===== CloudBase 生产环境变量模板 =====
# 在 CloudBase 控制台 → 云托管 → 服务配置 → 环境变量 中逐项填入

# 服务端口（云托管固定 3000，勿改）
PORT=3000

# 数据库（CloudBase PostgreSQL 连接串，控制台"数据库"页获取）
DATABASE_URL=postgres://用户名:密码@连接地址:5432/库名

# AI（DeepSeek，OpenAI 兼容协议；不配则全能力自动降级规则版，功能不挂）
AI_API_KEY=sk-xxxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 可选：识图批改多模态模型（DeepSeek 纯文本，不配则识图诚实降级）
# AI_VISION_MODEL=qwen-vl-plus

# 可选：微信登录
# WECHAT_APPID=wxXXXXXXXXXXXX
# WECHAT_SECRET=你的小程序AppSecret

# 可选：洞察扫描定时（默认每天 9 点）
# INSIGHT_SCAN_CRON=0 9 * * *
