<view class="page">
  <view class="hero">
    <view class="row">
      <view style="min-width:0">
        <view class="title" style="font-size:36rpx">{{profile.name || '同学'}}，你好</view>
        <view class="muted" style="margin-top:6rpx">{{roleText}} · {{childLabel}}</view>
      </view>
      <view class="btn btn-sm btn-light" bindtap="go" data-url="/pages/me/index">
        消息{{unread > 0 ? ' ' + unread : ''}}
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{loading}}">
    <view class="empty">加载中…</view>
  </view>

  <view class="section" wx:else>
    <view wx:if="{{blank}}" class="card">
      <view class="subtitle">欢迎使用</view>
      <view class="muted" style="margin-top:8rpx;line-height:1.6">
        现在还是空白的。团队排课、布置任务后，这里会显示今日课程与待完成任务。
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="grid-2" style="margin-bottom:20rpx">
      <view class="tile" bindtap="go" data-url="tab:/pages/schedule/index">
        <text class="tile-icon">📅</text>课程表
      </view>
      <view class="tile" bindtap="go" data-url="tab:/pages/tasks/index">
        <text class="tile-icon">✅</text>{{role === 'teacher' ? '批阅' : '任务打卡'}}
      </view>
      <view class="tile" bindtap="go" data-url="tab:/pages/lessons/index">
        <text class="tile-icon">⏱</text>课时账本
      </view>
      <view class="tile" bindtap="goReport">
        <text class="tile-icon">📋</text>学习周报
      </view>
    </view>

    <!-- 老师/管理员：待批阅 -->
    <view wx:if="{{role === 'teacher' || role === 'admin'}}" class="card">
      <view class="row">
        <view>
          <view class="muted">待批阅打卡</view>
          <view class="stat-num">{{pendingReview}}</view>
        </view>
        <view class="btn btn-sm" bindtap="go" data-url="tab:/pages/tasks/index">去处理</view>
      </view>
    </view>

    <!-- 管理员：概览 -->
    <view wx:if="{{role === 'admin' && overview}}" class="grid-3" style="margin-bottom:20rpx">
      <view class="stat-card"><view class="muted">学生</view><view class="subtitle">{{overview.studentCount}}</view></view>
      <view class="stat-card"><view class="muted">老师</view><view class="subtitle">{{overview.teacherCount}}</view></view>
      <view class="stat-card"><view class="muted">家长</view><view class="subtitle">{{overview.parentCount}}</view></view>
      <view class="stat-card"><view class="muted">本周课程</view><view class="subtitle">{{overview.weekCourseCount}}</view></view>
      <view class="stat-card"><view class="muted">待批阅</view><view class="subtitle">{{overview.pendingCheckinCount}}</view></view>
      <view class="stat-card"><view class="muted">消耗课时</view><view class="subtitle">{{overview.consumedLessons}}</view></view>
    </view>

    <!-- 今日课程 -->
    <view class="card-plain">
      <view class="row" style="margin-bottom:16rpx">
        <view class="subtitle">今日课程</view>
        <view class="text-primary" style="font-size:24rpx" bindtap="go" data-url="tab:/pages/schedule/index">全部</view>
      </view>
      <view wx:if="{{todayCourses.length === 0}}" class="empty">今天没有排课</view>
      <view wx:for="{{todayCourses}}" wx:key="id" class="item">
        <view class="row">
          <view style="min-width:0">
            <view class="subtitle">{{item.timeText}} {{item.subject}}</view>
            <view class="muted" style="margin-top:4rpx">
              {{role === 'teacher' ? '学生：' + item.studentName : '老师：' + item.teacherName}}{{item.location ? ' · ' + item.location : ''}}
            </view>
          </view>
          <text class="tag {{item.status === 'done' ? 'tag-g' : item.status === 'leave' ? 'tag-r' : ''}}">
            {{item.status === 'done' ? '已上' : item.status === 'leave' ? '请假' : '待上'}}
          </text>
        </view>
      </view>
    </view>

    <!-- 任务概览 -->
    <view wx:if="{{tasks && role !== 'admin'}}" class="card">
      <view class="row" style="margin-bottom:12rpx">
        <view class="subtitle">{{role === 'teacher' ? '任务概况' : '学习任务'}}</view>
        <view class="text-primary" style="font-size:24rpx" bindtap="go" data-url="tab:/pages/tasks/index">去打卡</view>
      </view>
      <view wx:if="{{role === 'teacher'}}" class="muted">
        已布置 {{tasks.items.length}} 个任务，待批阅 {{tasks.pendingCount}} 个
      </view>
      <view wx:else>
        <view class="row muted">
          <text>待完成 {{tasks.pendingCount}}</text>
          <text>已完成 {{tasks.doneCount}}</text>
          <text>连续打卡 {{tasks.streakDays}} 天</text>
        </view>
        <view class="bar"><view style="width:{{tasks.items.length ? (tasks.doneCount / tasks.items.length * 100) : 0}}%"></view></view>
      </view>
    </view>

    <!-- 课时余额 -->
    <view wx:if="{{role === 'student' || role === 'parent'}}" class="card">
      <view class="row">
        <view>
          <view class="muted">课时余额</view>
          <view class="stat-num">{{remaining}}<text class="muted" style="font-size:24rpx;font-weight:400"> 剩余课时</text></view>
        </view>
        <view class="btn btn-sm btn-ghost" bindtap="go" data-url="tab:/pages/lessons/index">明细</view>
      </view>
      <view wx:if="{{alertSubjects.length}}" class="text-warning tiny" style="margin-top:8rpx">
        {{alertSubjects.join('、')}} 课时不足，建议及时续费
      </view>
    </view>

    <!-- 最新内容 -->
    <view class="card-plain">
      <view class="subtitle" style="margin-bottom:16rpx">团队动态</view>
      <view wx:for="{{articles}}" wx:key="id" class="item">
        <view class="subtitle ellipsis">{{item.title}}</view>
        <view class="muted clamp2" style="margin-top:6rpx">{{item.summary || item.content}}</view>
        <view class="tiny" style="margin-top:6rpx">{{item.authorName}} · {{item.readCount}} 次阅读</view>
      </view>
    </view>
  </view>
</view>
