<view class="page">
  <view class="hero">
    <view class="title" style="font-size:36rpx">课时账本</view>
    <view class="muted" style="margin-top:6rpx">
      {{canPick ? '选择学生查看课时与消课流水' : '总购买、已消耗与剩余课时'}}
    </view>
  </view>

  <view class="section">
    <view wx:if="{{canPick && candidates.length}}" class="field-block">
      <picker mode="selector" range="{{candidates}}" range-key="label" bindchange="onPick">
        <view class="field">{{target ? targetLabel : '选择学生'}}</view>
      </picker>
    </view>
    <view wx:if="{{canPick && !target && candidates.length}}" class="empty">请先选择要查看的学生</view>

    <view wx:if="{{loading}}" class="empty">加载中…</view>

    <block wx:else>
      <view wx:for="{{summary.accounts}}" wx:key="subject" class="card">
        <view class="row">
          <text class="subtitle">{{item.subject}}</text>
          <text class="muted">共 {{item.totalLessons}} · 已消耗 {{item.usedLessons}}</text>
        </view>
        <view class="stat-num" style="margin-top:8rpx">
          {{item.remaining}}<text class="muted" style="font-size:24rpx;font-weight:400"> 剩余课时</text>
        </view>
        <view class="bar"><view style="width:{{item.totalLessons ? (item.usedLessons / item.totalLessons * 100) : 0}}%"></view></view>
        <view wx:if="{{item.remaining <= item.alertThreshold}}" class="text-warning tiny" style="margin-top:8rpx">
          剩余低于 {{item.alertThreshold}} 课时，建议及时续费
        </view>
      </view>

      <view class="subtitle" style="margin:8rpx 4rpx 16rpx">消课与增减流水</view>
      <view wx:if="{{!summary.ledgers.length}}" class="empty">暂无流水记录</view>
      <view wx:for="{{summary.ledgers}}" wx:key="id" class="item">
        <view class="row-top">
          <view style="min-width:0">
            <view class="subtitle">
              {{item.subject}} · {{typeText(item.changeType)}}
              <text wx:if="{{item.changeType === 'consume' && !item.confirmedAt}}" class="tag tag-o" style="margin-left:8rpx">待确认</text>
              <text wx:if="{{item.changeType === 'consume' && item.confirmedAt}}" class="tag tag-g" style="margin-left:8rpx">已确认</text>
            </view>
            <view class="muted" style="margin-top:4rpx">{{fmt(item.createdAt)}}{{item.remark ? ' · ' + item.remark : ''}}</view>
          </view>
          <view class="col" style="align-items:flex-end">
            <text class="bold {{item.changeAmount > 0 ? 'text-success' : 'text-danger'}}">
              {{item.changeAmount > 0 ? '+' : ''}}{{item.changeAmount}}
            </text>
            <button wx:if="{{item.changeType === 'consume' && !item.confirmedAt && (role === 'student' || role === 'parent')}}"
                    class="btn btn-sm btn-ghost" style="margin:8rpx 0 0" data-id="{{item.id}}" bindtap="confirm">确认无误</button>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
