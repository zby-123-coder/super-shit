<view class="page companion">
  <view class="row" style="gap:8rpx;margin-bottom:16rpx">
    <view wx:for="{{stages}}" wx:key="key"
          class="tag {{index <= stageIndex ? '' : 'tag-s'}}" style="flex:1;text-align:center">
      {{item.label}}
    </view>
  </view>

  <view class="chat">
    <view wx:if="{{starting}}" class="muted">小引正在准备…</view>
    <view wx:for="{{messages}}" wx:key="id"
          class="msg {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}">
      {{item.content}}
    </view>
  </view>

  <view wx:if="{{session.status === 'closed'}}" class="muted" style="text-align:center;padding:16rpx">
    本次引导已结束，可返回重新发起
  </view>
  <view wx:else class="row gap-8" style="margin-top:16rpx">
    <input class="field" style="flex:1;margin:0" placeholder="说出你的思路或卡点…"
           value="{{input}}" bindinput="onInput" bindconfirm="send" />
    <button class="btn btn-sm" style="margin:0" bindtap="send" disabled="{{sending}}">发送</button>
  </view>

  <text class="tiny" style="display:block;margin-top:16rpx;color:#8A9099">
    小引不会直接给答案，会一步步引导你自己做出来。
  </text>
</view>
